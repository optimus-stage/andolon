rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validDivision(v) {
      return v in ['Barishal', 'Chattogram', 'Dhaka', 'Khulna', 'Mymensingh', 'Rajshahi', 'Rangpur', 'Sylhet', 'Outside Bangladesh'];
    }
    // 1 to 24 letters, marks, numbers, space . _ - ; no space at the start or end; a few reserved names
    function validName(n) {
      return n is string
        && n.matches('^[\\p{L}\\p{M}\\p{N}_.-]([\\p{L}\\p{M}\\p{N} _.-]{0,22}[\\p{L}\\p{M}\\p{N}_.-])?$')
        && !(n.lower() in ['protester', 'officer', 'admin', 'administrator', 'andolon', 'আন্দোলন', 'আন্দোলনকারী', 'অফিসার']);
    }
    // daily challenge boards use Bangladesh time (UTC+6); a run finished just after midnight may still use yesterday's board
    function bdTime() { return request.time + duration.value(6, 'h'); }
    function dayKey(t) { return 'd' + string(t.year() * 10000 + t.month() * 100 + t.day()); }
    function validDay(day) { return day == dayKey(bdTime()) || day == dayKey(bdTime() - duration.value(1, 'd')); }
    // an avatar is a short string of option numbers such as "0.1.0.0.3.0.0.0.0.1"
    function validAv(v) { return v is string && v.matches('^[0-9.]{1,40}$'); }
    function validDaily(d, uid) {
      return d.keys().hasOnly(['uid', 'name', 'division', 'score', 'rank', 'stat', 'day', 'streak', 'av', 'updatedAt'])
        && (!('av' in d) || validAv(d.av))
        && d.uid == uid
        && d.name == getAfter(playerDoc(uid)).data.name
        && validDivision(d.division)
        && d.score is int && d.score >= 0 && d.score <= 100000
        && d.rank is string && d.rank.size() <= 40
        && d.stat is int && d.stat >= 0 && d.stat <= 1000
        && d.day is int && d.day >= 0 && d.day <= 1000
        && d.streak is int && d.streak >= 0 && d.streak <= 1000
        && d.updatedAt == request.time;
    }
    // lifetime profile (private to the owner): counters only ever go up, achievements are a short list of ids
    function numOk(n, k) { return !(k in n) || (n[k] is int && n[k] >= 0 && n[k] <= 1000000000); }
    function validProfile(d) {
      return d.keys().hasOnly(['n', 'ach', 'av', 'updatedAt'])
        && (!('av' in d) || (d.av is map && d.av.keys().hasOnly(['p', 'c']) && (!('p' in d.av) || validAv(d.av.p)) && (!('c' in d.av) || validAv(d.av.c))))
        && d.n is map && d.n.keys().hasOnly(['games', 'wins', 'winsP', 'winsPol', 'secs', 'recruits', 'peak', 'bestP', 'bestPol', 'dispersed', 'breaks', 'clashes', 'detained', 'beaten', 'cures', 'teas', 'dailies', 'bestStreak', 'squadPeak', 'smokes'])
        && numOk(d.n, 'games') && numOk(d.n, 'wins') && numOk(d.n, 'winsP') && numOk(d.n, 'winsPol') && numOk(d.n, 'secs') && numOk(d.n, 'recruits') && numOk(d.n, 'peak') && numOk(d.n, 'bestP') && numOk(d.n, 'bestPol') && numOk(d.n, 'dispersed') && numOk(d.n, 'breaks') && numOk(d.n, 'clashes') && numOk(d.n, 'detained') && numOk(d.n, 'beaten') && numOk(d.n, 'cures') && numOk(d.n, 'teas') && numOk(d.n, 'dailies') && numOk(d.n, 'bestStreak') && numOk(d.n, 'squadPeak') && numOk(d.n, 'smokes')
        && d.ach is list && d.ach.size() <= 40
        && d.updatedAt == request.time;
    }
    function nonDecreasing(a, b) {
      return a.n.get('games', 0) >= b.n.get('games', 0) && a.n.get('wins', 0) >= b.n.get('wins', 0) && a.n.get('winsP', 0) >= b.n.get('winsP', 0) && a.n.get('winsPol', 0) >= b.n.get('winsPol', 0) && a.n.get('secs', 0) >= b.n.get('secs', 0) && a.n.get('recruits', 0) >= b.n.get('recruits', 0) && a.n.get('peak', 0) >= b.n.get('peak', 0) && a.n.get('bestP', 0) >= b.n.get('bestP', 0) && a.n.get('bestPol', 0) >= b.n.get('bestPol', 0) && a.n.get('dispersed', 0) >= b.n.get('dispersed', 0) && a.n.get('breaks', 0) >= b.n.get('breaks', 0) && a.n.get('clashes', 0) >= b.n.get('clashes', 0) && a.n.get('detained', 0) >= b.n.get('detained', 0) && a.n.get('beaten', 0) >= b.n.get('beaten', 0) && a.n.get('cures', 0) >= b.n.get('cures', 0) && a.n.get('teas', 0) >= b.n.get('teas', 0) && a.n.get('dailies', 0) >= b.n.get('dailies', 0) && a.n.get('bestStreak', 0) >= b.n.get('bestStreak', 0) && a.n.get('squadPeak', 0) >= b.n.get('squadPeak', 0) && a.n.get('smokes', 0) >= b.n.get('smokes', 0);
    }
    function nameDoc(n) { return /databases/$(database)/documents/names/$(n.lower()); }
    function playerDoc(uid) { return /databases/$(database)/documents/players/$(uid); }
    function validDoc(d, uid) {
      return d.keys().hasOnly(['uid', 'name', 'division', 'score', 'rank', 'stat', 'day', 'av', 'updatedAt'])
        && (!('av' in d) || validAv(d.av))
        && d.uid == uid
        && d.name == getAfter(playerDoc(uid)).data.name   // the leaderboard name is the player's registered, unique nickname
        && validDivision(d.division)
        && d.score is int && d.score >= 0 && d.score <= 100000
        && d.rank is string && d.rank.size() <= 40
        && d.stat is int && d.stat >= 0 && d.stat <= 1000
        && d.day is int && d.day >= 0 && d.day <= 1000
        && d.updatedAt == request.time;
    }
    // analytics counters (totals only, no personal data): stats/global and one document per Bangladesh day (stats/d20261022).
    // Any signed-in visitor may add 1 to 5 to a counter per write; nobody may lower or reset one.
    function bump(k) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([k])
        || (request.resource.data[k] - resource.data.get(k, 0) >= 1 && request.resource.data[k] - resource.data.get(k, 0) <= 5);
    }
    function first(k) { return request.resource.data.get(k, 1) >= 1 && request.resource.data.get(k, 1) <= 5; }
    // only the owner's verified Google account may read the analytics; everybody can still add to the counters
    function isOwner() { return request.auth != null && request.auth.token.email == 'bizwithsabbir@gmail.com' && request.auth.token.email_verified == true; }
    function statsKeys() { return request.resource.data.keys().hasOnly(['players', 'games', 'games_protester', 'games_police', 'challenges', 'lang_bn', 'lang_en', 'dev_touch', 'dev_desktop', 'daily_start', 'ret_d1', 'ret_d7', 'fin_p', 'fin_c', 'win_p', 'win_c', 'end_detained', 'end_timeout', 'pend_held', 'pend_anger', 'ring0', 'ring1', 'ring2', 'ring3', 'daily_fin', 'challenge_wins', 'share_card', 'share_challenge', 'tut_done', 'tut_skip', 'lb_submits', 'daily_submits', 'google_links', 'profile_opens']); }
    function statsDoc(doc) { return doc == 'global' || doc == dayKey(bdTime()); }
    match /stats/{doc} {
      allow read: if isOwner();
      allow create: if request.auth != null && statsDoc(doc) && statsKeys()
        && first('players') && first('games') && first('games_protester') && first('games_police') && first('challenges') && first('lang_bn') && first('lang_en') && first('dev_touch') && first('dev_desktop') && first('daily_start') && first('ret_d1') && first('ret_d7') && first('fin_p') && first('fin_c') && first('win_p') && first('win_c') && first('end_detained') && first('end_timeout') && first('pend_held') && first('pend_anger') && first('ring0') && first('ring1') && first('ring2') && first('ring3') && first('daily_fin') && first('challenge_wins') && first('share_card') && first('share_challenge') && first('tut_done') && first('tut_skip') && first('lb_submits') && first('daily_submits') && first('google_links') && first('profile_opens');
      allow update: if request.auth != null && statsDoc(doc) && statsKeys()
        && bump('players') && bump('games') && bump('games_protester') && bump('games_police') && bump('challenges') && bump('lang_bn') && bump('lang_en') && bump('dev_touch') && bump('dev_desktop') && bump('daily_start') && bump('ret_d1') && bump('ret_d7') && bump('fin_p') && bump('fin_c') && bump('win_p') && bump('win_c') && bump('end_detained') && bump('end_timeout') && bump('pend_held') && bump('pend_anger') && bump('ring0') && bump('ring1') && bump('ring2') && bump('ring3') && bump('daily_fin') && bump('challenge_wins') && bump('share_card') && bump('share_challenge') && bump('tut_done') && bump('tut_skip') && bump('lb_submits') && bump('daily_submits') && bump('google_links') && bump('profile_opens');
    }
    // one record per signed-in user: the nickname and division
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'division', 'nameChangedAt'])
        && validName(request.resource.data.name) && validDivision(request.resource.data.division)
        && request.resource.data.nameChangedAt == request.time
        && getAfter(nameDoc(request.resource.data.name)).data.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'division', 'nameChangedAt'])
        && validName(request.resource.data.name) && validDivision(request.resource.data.division)
        && (
          // only the division changed
          (request.resource.data.name == resource.data.name && request.resource.data.nameChangedAt == resource.data.nameChangedAt)
          // new nickname: the new name must be claimed and the old one released in the same write
          || (request.resource.data.nameChangedAt == request.time
              && getAfter(nameDoc(request.resource.data.name)).data.uid == uid
              && !existsAfter(nameDoc(resource.data.name)))
        );
    }
    // nickname claims: the document id is the lower-case nickname, so two players can never hold the same one
    match /names/{key} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name) && key == request.resource.data.name.lower()
        && getAfter(playerDoc(request.auth.uid)).data.name == request.resource.data.name;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /daily/{day}/{role}/{uid} {
      allow read: if role in ['protester', 'police'];
      allow create: if role in ['protester', 'police'] && request.auth != null && request.auth.uid == uid && validDay(day) && validDaily(request.resource.data, uid);
      allow update: if role in ['protester', 'police'] && request.auth != null && request.auth.uid == uid && validDay(day) && validDaily(request.resource.data, uid)
        && request.resource.data.score >= resource.data.score;
      allow delete: if role in ['protester', 'police'] && request.auth != null && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && validProfile(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid && validProfile(request.resource.data) && nonDecreasing(request.resource.data, resource.data);
    }
    match /{board}/{uid} {
      allow read: if board in ['lb_protester', 'lb_police'];
      allow create: if board in ['lb_protester', 'lb_police'] && request.auth != null && request.auth.uid == uid && validDoc(request.resource.data, uid);
      // a score can only go up; name and division can be changed
      allow update: if board in ['lb_protester', 'lb_police'] && request.auth != null && request.auth.uid == uid && validDoc(request.resource.data, uid)
        && request.resource.data.score >= resource.data.score;
      allow delete: if board in ['lb_protester', 'lb_police'] && request.auth != null && request.auth.uid == uid;
    }
  }
}
